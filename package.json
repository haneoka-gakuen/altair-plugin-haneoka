{
  "name": "@haneoka/altair-plugin-haneoka",
  "version": "0.1.0",
  "description": "Haneoka catalog resource browsing and source normalization for Altair",
  "keywords": [
    "altair",
    "haneoka",
    "visual-novel",
    "resource-browser",
    "plugin"
  ],
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haneoka-gakuen/altair-plugin-haneoka.git"
  },
  "bugs": {
    "url": "https://github.com/haneoka-gakuen/altair-plugin-haneoka/issues"
  },
  "homepage": "https://github.com/haneoka-gakuen/altair-plugin-haneoka#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:pack": "npm pack --dry-run --ignore-scripts",
    "check": "pnpm run typecheck && pnpm run build && pnpm run verify:package && pnpm run verify:pack",
    "prepack": "pnpm run check"
  },
  "peerDependencies": {
    "@haneoka/altair": "^0.1.0",
    "@haneoka/altair-plugin-adv": "^0.1.0"
  },
  "devDependencies": {
    "@haneoka/altair": "workspace:*",
    "@haneoka/altair-plugin-adv": "workspace:*",
    "@types/node": "^26.1.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.14.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "altair": {
    "pluginApi": 2,
    "kind": "service",
    "capabilities": [
      "assets",
      "services"
    ],
    "permissions": [
      "network"
    ],
    "targets": [
      "web",
      "pwa",
      "electron",
      "tauri",
      "android",
      "ios"
    ]
  }
}
